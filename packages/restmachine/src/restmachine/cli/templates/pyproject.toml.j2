[build-system]
requires = ["setuptools>=61.0", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ project_name }} - A RestMachine application"
requires-python = ">=3.9"
dependencies = [
    "restmachine",
    "restmachine-orm",
    "uvicorn[standard]>=0.20.0",
    "python-dotenv>=1.0.0",
    "pydantic[email]>=2.0.0",
]

[project.optional-dependencies]
aws = [
    "restmachine-aws",
    "restmachine-orm-dynamodb",
]
dev = [
    "pytest>=7.0",
    "pytest-cov",
    "httpx",  # For testing
    "ruff",
    "mypy",
]

[tool.setuptools.packages.find]
where = ["."]
include = ["{{ project_name }}*", "models*", "schemas*", "controllers*", "config*", "lib*"]

[tool.pytest.ini_options]
testpaths = ["tests"]
python_files = ["test_*.py"]
python_classes = ["Test*"]
python_functions = ["test_*"]
addopts = "-v --tb=short"

[tool.ruff]
line-length = 100
target-version = "py39"

[tool.mypy]
python_version = "3.9"
warn_return_any = true
warn_unused_configs = true
disallow_untyped_defs = false
