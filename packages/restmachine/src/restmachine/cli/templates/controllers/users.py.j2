"""
User endpoints for {{ project_name }}.

Provides CRUD endpoints for users.
"""

import uuid
from restmachine import Router, Response
from models.user import User
from schemas.user_schemas import UserCreate, UserUpdate, UserResponse

router = Router()


# Resource loader - load user from path parameters
@router.dependency
def user(database, path_params):
    """Load user from path parameters.

    Returns None if user not found, route handlers must check for None.
    """
    user_id = path_params.get('user_id')
    if not user_id:
        return None

    return database.query(User).get(id=user_id)


# Validation dependencies
@router.validates
def validate_user_create(json_body) -> UserCreate:
    """Validate user creation request."""
    return UserCreate.model_validate(json_body)


@router.validates
def validate_user_update(json_body) -> UserUpdate:
    """Validate user update request."""
    return UserUpdate.model_validate(json_body)


# Routes (relative to mount point)
@router.get('/')
def list_users(database):
    """List all users."""
    users = database.query(User).all()
    return [UserResponse.model_validate(u.model_dump()).model_dump() for u in users]


@router.get('/{user_id}')
def get_user(user):
    """Get a specific user."""
    if user is None:
        return Response(status_code=404, body={'error': 'User not found'})
    return UserResponse.model_validate(user.model_dump()).model_dump()


@router.post('/')
def create_user(database, validate_user_create: UserCreate):
    """Create a new user."""
    user = User(
        id=str(uuid.uuid4()),
        email=validate_user_create.email,
        name=validate_user_create.name,
    )
    user.save()
    return Response(
        status_code=201,
        body=UserResponse.model_validate(user.model_dump()).model_dump()
    )


@router.put('/{user_id}')
def update_user(user, validate_user_update: UserUpdate):
    """Update a user."""
    if user is None:
        return Response(status_code=404, body={'error': 'User not found'})
    if validate_user_update.name:
        user.name = validate_user_update.name
    if validate_user_update.email:
        user.email = validate_user_update.email
    user.save()
    return UserResponse.model_validate(user.model_dump()).model_dump()


@router.delete('/{user_id}')
def delete_user(user):
    """Delete a user."""
    if user is None:
        return Response(status_code=404, body={'error': 'User not found'})
    user.delete()
    return Response(status_code=204)
