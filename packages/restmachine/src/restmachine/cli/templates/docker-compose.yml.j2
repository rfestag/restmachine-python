version: '3.8'

services:
  app:
    build: .
    ports:
      - "3000:3000"
    env_file:
      - .env
    volumes:
      - .:/app
    environment:
      - RESTMACHINE_CONFIG_PATH=local
      - RESTMACHINE_ENVIRONMENT=development
    command: uvicorn app:asgi_app --host 0.0.0.0 --port 3000 --reload
