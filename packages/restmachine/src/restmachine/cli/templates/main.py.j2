#!/usr/bin/env python
"""
{{ project_name }} development server.

Usage:
    python main.py
    python main.py --port 3000
    python main.py --host 127.0.0.1 --port 8080
"""

import argparse
import uvicorn
from app import app
from config.settings import settings


def main():
    """Run the development server."""
    parser = argparse.ArgumentParser(description='Run the {{ project_name }} development server')
    parser.add_argument(
        '--host',
        default=settings.get('server.host', '0.0.0.0'),
        help='Host to bind to'
    )
    parser.add_argument(
        '--port',
        type=int,
        default=settings.get('server.port', 8000),
        help='Port to bind to'
    )
    parser.add_argument(
        '--reload',
        action='store_true',
        default=settings.get('app.debug', False),
        help='Enable auto-reload on code changes'
    )
    parser.add_argument(
        '--log-level',
        default=settings.get('app.log_level', 'INFO').lower(),
        choices=['critical', 'error', 'warning', 'info', 'debug'],
        help='Log level'
    )

    args = parser.parse_args()

    print(f"Starting {{ project_name }} server on {args.host}:{args.port}")
    print(f"Environment: {settings.get('app.environment', 'development')}")
    print(f"Reload: {args.reload}")

    uvicorn.run(
        "app:app",  # Import string for reload to work
        host=args.host,
        port=args.port,
        reload=args.reload,
        log_level=args.log_level
    )


if __name__ == '__main__':
    main()
