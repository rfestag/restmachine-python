    def test_list_{{ resource_plural }}_returns_paginated_response(self, client):
        """Test listing {{ resource_plural }} returns proper pagination structure."""
        response = client.get('/{{ resource_plural }}')
        assert response.status_code == 200

        data = response.json()
        assert 'items' in data
        assert 'next_cursor' in data
        assert 'has_more' in data
        assert isinstance(data['items'], list)

    def test_list_{{ resource_plural }}_with_limit(self, client):
        """Test pagination limit parameter."""
        response = client.get('/{{ resource_plural }}?limit=10')
        assert response.status_code == 200

        data = response.json()
        assert len(data['items']) <= 10

    def test_list_{{ resource_plural }}_with_cursor(self, client):
        """Test cursor-based pagination."""
        # Get first page
        response = client.get('/{{ resource_plural }}?limit=5')
        data = response.json()

        if data['has_more']:
            # Get second page
            response2 = client.get(f'/{{ resource_plural }}?cursor={data["next_cursor"]}')
            assert response2.status_code == 200

